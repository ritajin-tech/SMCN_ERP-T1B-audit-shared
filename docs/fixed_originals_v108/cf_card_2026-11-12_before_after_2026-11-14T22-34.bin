  .sw{display:inline-block;width:13px;height:13px;border:1px solid #ccd2da;border-radius:3px;vertical-align:-2px;margin-right:5px}
  .notice{background:#fff8e8;border-left:4px solid #e0a800;padding:12px 15px;border-radius:0 8px 8px 0;margin:14px 0}
  .g{background:#eef7f1;border-left-color:#2e8b57}
  ul{margin:8px 0 8px 20px;padding:0}li{margin:5px 0}
  footer{margin-top:26px;padding-top:14px;border-top:1px solid var(--line);color:var(--sub);font-size:12px}
