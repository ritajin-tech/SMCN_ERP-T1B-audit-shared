// 1) 一次性备份当前页（幂等：已存在则跳过）。写入前必先跑它。
function backupAttendanceSheet() {
  try {
    var ss = _lsGetMasterSs();
    if (ss.getSheetByName(REBUILD_BAK)) return '[SKIP] 备份已存在: ' + REBUILD_BAK;
    var src = ss.getSheetByName(REBUILD_SHEET);
    if (!src) return '[ABORT] 找不到源页: ' + REBUILD_SHEET;
    var copy = src.copyTo(ss);
    copy.setName(REBUILD_BAK);
    return '[OK] 已备份到: ' + REBUILD_BAK;
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

// 2) 备份优先，然后就地重建（4–12 月），清空下方残留（旧 1–3 月/历史垃圾）。
function rebuildAttendanceSheet() {
  try {
    var bk = backupAttendanceSheet();
    if (bk.indexOf('[ERROR]') === 0 || bk.indexOf('[ABORT]') === 0) {
      return '[ABORT] 备份失败，已中止写入。备份返回：' + bk;
    }
    var ss = _lsGetMasterSs();
    var sheet = ss.getSheetByName(REBUILD_SHEET);
    if (!sheet) return '[ABORT] 找不到页: ' + REBUILD_SHEET;
    var grid = REBUILD_GRID;
    var nRows = grid.length, nCols = grid[0] ? grid[0].length : 0;
    if (nRows < 1 || nCols < 1) return '[ABORT] 网格为空';
    // 确保表格足够大，避免 setValues 越界
    if (sheet.getMaxRows() < nRows) sheet.insertRowsAfter(sheet.getMaxRows(), nRows - sheet.getMaxRows());
    if (sheet.getMaxColumns() < nCols) sheet.insertColumnsAfter(sheet.getMaxColumns(), nCols - sheet.getMaxColumns());
    sheet.getRange(1, 1, nRows, nCols).setValues(grid);   // A1 起写入重建块（4–12 月）
    var maxRows = sheet.getMaxRows();
    if (maxRows > nRows) {
      sheet.getRange(nRows + 1, 1, maxRows - nRows, nCols).clearContent(); // 清空下方残留（仅数值，不删行）
    }
    try { _tsWriteLog('attendance_rebuild', '重建「按月考勤」：写入 ' + nRows + '×' + nCols + '；备份=' + bk); } catch (eLog) {}
    return '[OK] 已重建 ' + REBUILD_SHEET + '：写入 ' + nRows + '×' + nCols + '，已清空下方 ' + (maxRows - nRows) + ' 行残留；备份=' + bk;
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

// 3) 读回校验：月份块、最大单日、残留是否为空。
function verifyRebuild() {
  try {
    var ss = _lsGetMasterSs();
    var sheet = ss.getSheetByName(REBUILD_SHEET);
    if (!sheet) return '[ABORT] 找不到页';
    var nRows = REBUILD_GRID.length, nCols = REBUILD_GRID[0].length;
    var vals = sheet.getRange(1, 1, nRows, nCols).getValues();
    var months = {}; var maxV = -1; var nonEmpty = 0;
    for (var r = 0; r < vals.length; r++) for (var c = 0; c < vals[r].length; c++) {
      var v = vals[r][c];
      if (v === '' || v === null || v === undefined) continue;
      nonEmpty++;
      var m = String(v).match(/2026年(\d+)月/); if (m) months[m[1]] = true;
      if (typeof v === 'number' && v > maxV) maxV = v;
    }
    var maxRows = sheet.getMaxRows();
    var residual = false;
    if (maxRows > nRows) {
      var tail = sheet.getRange(nRows + 1, 1, Math.min(maxRows - nRows, 300), nCols).getValues();
      for (var r2 = 0; r2 < tail.length; r2++) for (var c2 = 0; c2 < tail[r2].length; c2++)
        if (tail[r2][c2] !== '' && tail[r2][c2] != null) residual = true;
    }
    return JSON.stringify({
      sheet: REBUILD_SHEET,
      writtenRows: nRows, writtenCols: nCols, nonEmptyCells: nonEmpty,
      monthsPresent: Object.keys(months).sort(),
      maxValue: maxV,
      residualBelowHasContent: residual,
      maxRowsInSheet: maxRows
    });
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

// 4) 一键回滚：把备份页整体拷回目标页（仅在需要时手动调用）。
function restoreAttendanceSheet() {
  try {
    var ss = _lsGetMasterSs();
    var bak = ss.getSheetByName(REBUILD_BAK);
    if (!bak) return '[ABORT] 无备份页: ' + REBUILD_BAK;
    var dest = ss.getSheetByName(REBUILD_SHEET);
    if (!dest) return '[ABORT] 找不到目标页';
    var vals = bak.getDataRange().getValues();
    dest.clear();
    dest.getRange(1, 1, vals.length, vals[0].length).setValues(vals);
    return '[OK] 已从备份恢复 ' + REBUILD_SHEET;
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

