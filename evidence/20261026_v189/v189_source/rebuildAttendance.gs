function _calParseMd(v) {
  if (v instanceof Date) {
    var mm = ('0' + (v.getMonth() + 1)).slice(-2), dd = ('0' + v.getDate()).slice(-2);
    return mm + '-' + dd;
  }
  var s = String(v == null ? '' : v).trim();
  var m = s.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})$/);
  if (m) return ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
  var m2 = s.match(/^(\d{1,2})[-/.](\d{1,2})$/);
  if (m2) return ('0' + m2[1]).slice(-2) + '-' + ('0' + m2[2]).slice(-2);
  return '';
}

function _calDayInfo(md) {
  if (!md) return null;
  if (CAL_HOLIDAY_2026[md]) return { type:'holiday', label:CAL_HOLIDAY_2026[md] };
  if (CAL_MAKEUP_2026[md]) return { type:'makeup', label:CAL_MAKEUP_2026[md] };
  var p = md.split('-');
  var d = new Date(2026, parseInt(p[0], 10) - 1, parseInt(p[1], 10));
  var w = d.getDay();
  var wName = ['周日','周一','周二','周三','周四','周五','周六'][w];
  if (w === 0 || w === 6) return { type:'weekend', label:wName + '·周末' };
  return { type:'work', label:wName + '·工作日' };
}

// 只读诊断：回读「按月考勤」，确认表头里到底有哪些日期列（周末/节假日到底在不在）。
function readAttendanceHeader() {
  try {
    var ss = _lsGetMasterSs();
    var sheet = ss.getSheetByName(REBUILD_SHEET);
    if (!sheet) return '[ABORT] 找不到页: ' + REBUILD_SHEET;
    var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    var vals = sheet.getRange(1, 1, Math.min(lastRow, 12), Math.min(lastCol, 40)).getValues();
    var headerRows = [];
    for (var r = 0; r < vals.length; r++) {
      if (String(vals[r][0]).trim() === '姓名') {
        var dates = [];
        for (var c = 1; c < vals[r].length; c++) {
          var md = _calParseMd(vals[r][c]);
          if (md) dates.push(md);
        }
        headerRows.push({ row: r + 1, dateCount: dates.length, dates: dates });
      }
    }
    var out = JSON.stringify({
      sheet: REBUILD_SHEET,
      lastRow: lastRow, lastCol: lastCol,
      monthBlocksFound: headerRows.length,
      headerRows: headerRows
    });
    try { SpreadsheetApp.getUi().alert('考勤表头诊断（只读）', out, SpreadsheetApp.getUi().ButtonSet.OK); } catch (eUi) {}
    return out;
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

// 纯展示：给所有月份块的日期表头上底色 + 批注（周末灰 / 法定假红 / 调休补班黄）。
// 不改数值、不插行列、不动任何工时或请假数据。
function attendanceMarkCalendar() {
  try {
    var ss = _lsGetMasterSs();
    var sheet = ss.getSheetByName(REBUILD_SHEET);
    if (!sheet) return '[ABORT] 找不到页: ' + REBUILD_SHEET;
    var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    if (lastRow < 1 || lastCol < 1) return '[ABORT] 空表';
    var vals = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    var marked = 0, blocks = 0;
    for (var r = 0; r < vals.length; r++) {
      if (String(vals[r][0]).trim() !== '姓名') continue;
      blocks++;
      for (var c = 1; c < vals[r].length; c++) {
        var md = _calParseMd(vals[r][c]);
        if (!md) continue;
        var info = _calDayInfo(md);
        if (!info) continue;
        var cell = sheet.getRange(r + 1, c + 1);
        cell.setBackground(CAL_COLOR[info.type] || '#FFFFFF');
        var note = info.label;
        if (CAL_NOTE_EXTRA[md]) note += ' | ' + CAL_NOTE_EXTRA[md];
        cell.setNote(note);
        marked++;
      }
    }
    try { _tsWriteLog('attendance_calendar_mark', '标记日历：块=' + blocks + ' 单元格=' + marked + '（纯展示，零数据改动）'); } catch (eLog) {}
    return '[OK] 已标记 ' + REBUILD_SHEET + '：月份块=' + blocks + '，日期单元格=' + marked + '（周末灰/法定假红/调休补班黄；纯展示，未改任何数值）';
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}

// 纯展示：请假/短工时条件配色（2026-10-21 Rita 反馈"请假看不清"——旧粉底把请假、短工时、
// 法定假红全混成一色）。本函数【全量替换】本页条件格式为两条规则：
//   蓝 #C9DCF0 / 深蓝字 #174EA6 = 含"假"（请假，含半天假）
//   橙 #FCE5CD / 棕字   #B26B00 = 0 < 工时 < 8（短工时）
// 表头静态色由 attendanceMarkCalendar() 负责（灰=周末/红=法定假/黄=补班）。
// 不改任何数值；幂等可反复点。新增月份块后重跑一次即可。
function attendanceMarkLeaveCF() {
  try {
    var ss = _lsGetMasterSs();
    var sheet = ss.getSheetByName(REBUILD_SHEET);
    if (!sheet) return '[ABORT] 找不到页: ' + REBUILD_SHEET;
    var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    if (lastRow < 2 || lastCol < 2) return '[ABORT] 空表';
    var vals = sheet.getRange(1, 1, lastRow, lastCol).getValues();

    // 1) 找所有月份块（表头行 = A 列"姓名"），块数据区 = 表头行+1 到 下一块的月份标题行-1（或表尾）
    var blocks = [];
    for (var r = 0; r < lastRow; r++) {
      if (String(vals[r][0]).trim() !== '姓名') continue;
      var cols = [];
      for (var c = 1; c < lastCol; c++) if (_calParseMd(vals[r][c])) cols.push(c);
      if (cols.length) blocks.push({ header1: r + 1, colStart: cols[0] + 1, colCount: cols.length, dataStart: r + 2 });
    }
    if (!blocks.length) return '[ABORT] 未找到月份块表头';
    for (var i = 0; i < blocks.length; i++) {
      var end1 = (i + 1 < blocks.length) ? blocks[i + 1].header1 - 2 : lastRow;
      if (end1 < blocks[i].dataStart) end1 = blocks[i].dataStart;
      blocks[i].dataEnd = end1;
    }

    // 2) 全量替换本页条件格式（沿用 tsSetCondFormat 的"全量替换"先例；先记录旧规则数）
    var oldRules = sheet.getConditionalFormatRules();
    var ranges = [];
    for (var j = 0; j < blocks.length; j++) {
      var b = blocks[j];
      ranges.push(sheet.getRange(b.dataStart, b.colStart, b.dataEnd - b.dataStart + 1, b.colCount));
    }
    var leaveRule = SpreadsheetApp.newConditionalFormatRule()
      .whenTextContains('假')
      .setBackground('#C9DCF0').setFontColor('#174EA6')
      .setRanges(ranges).build();
    var shortRule = SpreadsheetApp.newConditionalFormatRule()
      .whenNumberLessThan(8).whenNumberGreaterThan(0)
      .setBackground('#FCE5CD').setFontColor('#B26B00')
      .setRanges(ranges).build();
    sheet.setConditionalFormatRules([leaveRule, shortRule]);

    try { _tsWriteLog('attendance_leave_cf', 'CF 全量替换：旧规则=' + oldRules.length + ' → 2 条（蓝=假 / 橙=0<h<8），块=' + blocks.length); } catch (eLog) {}
    return '[OK] 已重设「按月考勤」条件配色：旧规则 ' + oldRules.length + ' 条 → 2 条（蓝=请假 / 橙=短工时0-8h），月份块=' + blocks.length + '；纯展示，未改任何数值。';
  } catch (err) {
    return '[ERROR] ' + (err && err.message ? err.message : err);
  }
}
